# See README.md for local development, docs/deployment-dokploy.md for a VPS.
DATABASE_URL="postgresql://user:password@localhost:5432/wikioui"

# Signs the session cookies (BetterAuth, ADR 0023). Generate one with
# `openssl rand -base64 32`. In production the wiki refuses to start without
# it, rather than signing sessions with a value anyone could guess.
BETTER_AUTH_SECRET="run-openssl-rand-base64-32-and-paste-the-result-here"

# Public address of the wiki: sign-in requests coming from another origin are
# refused. Without it the origin is taken from the request itself. It is also
# the address the invitation links carry, since they leave the wiki.
BETTER_AUTH_URL="http://localhost:3000"

# Optional. Sending is a delivery mode, never a dependency (docs/permissions.md):
# without these two the wiki mints invitation and password links all the same,
# and the administrator copies them. With them, it sends them as well.
# SMTP_URL="smtps://user:password@smtp.example.org:465"
# SMTP_FROM="WikiOui <wiki@example.org>"
