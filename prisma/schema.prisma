generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- BetterAuth ---------------------------------------------------------
// Generated by the BetterAuth CLI (ADR 0023) and regenerated at every
// version bump — `username` and `displayUsername` come from the `username`
// plugin. What WikiOui adds lives in the models below, save for what can only
// live on the account itself: its back-relations, and `disabledAt`.
// All tables stay in the `public` schema: no multiSchema.

model User {
  id              String    @id
  name            String // display name, free — a pseudonym is accepted
  email           String // private: shown in gerer-utilisateurs and nowhere else
  emailVerified   Boolean   @default(false)
  image           String? // avatar, uploaded into files/ (ADR 0012)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  username        String? // public identifier, slug pattern (lib/username.ts)
  displayUsername String?
  sessions        Session[]
  accounts        Account[]

  // Access cut, the reversible half of « fin d'un compte »
  // (docs/permissions.md): sign-in is refused and the sessions are revoked,
  // while ownership and authorship stay exactly as they were. A date rather
  // than a flag — a wiki asked one day since when will have the answer. The
  // `admin` plugin's `banned` is not it: that plugin is not used, because
  // being an administrator is a membership and not a column (ADR 0023).
  disabledAt DateTime?

  // What WikiOui hangs on the account. The rights point at `username`, never
  // at `id` (ADR 0024), so these are its back-relations.
  groupMemberships  GroupMember[]
  pageAcls          PageAcl[]
  ownedForms        Form[]        @relation("FormOwner")
  ownedPages        Page[]        @relation("PageOwner")
  authoredRevisions Revision[]    @relation("RevisionAuthor")

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- WikiOui ------------------------------------------------------------

// A group holds people and/or other groups, with no depth limit
// (docs/permissions.md § Groupes). @Admins is one of them: administration is
// a membership, not a role column.
model Group {
  slug String @id // presented as @slug
  name String

  members     GroupMember[] @relation("GroupMembers")
  memberships GroupMember[] @relation("NestedGroup")
  invitations AccountLink[]
  pageAcls    PageAcl[]
}

// A single-use link that lets whoever holds it choose a password
// (docs/permissions.md § Naissance d'un compte). One primitive for three
// needs — invitation, forgotten password, reset triggered by an administrator
// — the only difference being whether the address already holds an account,
// and how long the link lasts. Sending it by mail is a delivery mode, never a
// dependency: an administrator can copy it and hand it over as they wish.
model AccountLink {
  id String @id @default(uuid(7)) @db.Uuid

  // One live link per address, so a second invitation refreshes the first
  // rather than leaving two doors open — this is what merges the duplicates
  // of a pasted list, in the database rather than in the parser.
  email String @unique

  // The link is the secret; the database keeps only its fingerprint, so a
  // stolen dump opens nothing. Single use: the row goes when the link is used.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // « Ajouter aussi au groupe », applied when the invitation is accepted. Set
  // null if the group is deleted meanwhile: the invitation still stands, it
  // just no longer leads anywhere in particular.
  groupSlug String?
  group     Group?  @relation(fields: [groupSlug], references: [slug], onUpdate: Cascade, onDelete: SetNull)
}

// One membership: a person or a nested group, never both — a CHECK in the
// migration holds the invariant. Cascade on both sides: a membership
// disappears with what it names, which is the intended effect (ADR 0024).
model GroupMember {
  id String @id @default(uuid(7)) @db.Uuid

  groupSlug String
  group     Group  @relation("GroupMembers", fields: [groupSlug], references: [slug], onUpdate: Cascade, onDelete: Cascade)

  username String?
  user     User?   @relation(fields: [username], references: [username], onUpdate: Cascade, onDelete: Cascade)

  memberGroupSlug String?
  memberGroup     Group?  @relation("NestedGroup", fields: [memberGroupSlug], references: [slug], onUpdate: Cascade, onDelete: Cascade)

  @@unique([groupSlug, username])
  @@unique([groupSlug, memberGroupSlug])
  @@index([username])
  @@index([memberGroupSlug])
}

// Single row (CHECK id = 1 in the migration). First occupant of the table
// already planned for SMTP, the site title and hot-editable default rights —
// they will move in without a second migration (ADR 0027).
model Settings {
  id          Int       @id @default(1)
  installedAt DateTime? // set once, never cleared: the installation screen is a one-way door
}

// A form definition (ADR 0014): written at runtime by the FormBuilder,
// never historized (saving overwrites). Deleting a form deletes its entries.
model Form {
  id        String   @id @default(uuid(7)) @db.Uuid // technical PK, never shown
  slug      String   @unique // the user-facing "id", immutable after creation
  name      String
  schema    Json // field descriptor, written by the FormBuilder
  template  String? // optional MDX template for entry rendering
  createdAt DateTime @default(now())

  // SetNull, not Cascade: deleting an account must not take its forms — and
  // their entries — with it (ADR 0024). null reads as "Anonyme".
  ownerUsername String?
  owner         User?   @relation("FormOwner", fields: [ownerUsername], references: [username], onUpdate: Cascade, onDelete: SetNull)

  entries Page[]

  @@index([ownerUsername])
}

// The three exclusive scopes of a right (docs/permissions.md § Le droit).
// There is no `admins` scope: administrators are an invariant, not one option
// among three, and offering it would suggest the other two exclude them.
enum Scope {
  everyone
  authenticated
  restricted // « seulement » — the owner, the administrators, and the list
}

enum PermKind {
  READ
  WRITE
}

model Page {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  tags      String[] // Postgres text[] (ADR 0007)
  createdAt DateTime @default(now())

  // The scope is a column, the list is a table: a scalar on one side, a
  // collection on the other — and in an ordinary wiki the vast majority of
  // pages have no row in PageAcl at all, so the common case is decided
  // without touching it. No default here on purpose: the wiki's defaults are
  // copied at creation by lib/permissions.ts, never linked (ADR 0026), and a
  // second default in the database would be a second source of truth.
  readScope  Scope
  writeScope Scope
  acls       PageAcl[]

  // SetNull, not Cascade: the same cascade would destroy pages when an
  // account is erased (ADR 0024). A page without an owner reads as
  // "Anonyme", and only administrators can write it.
  ownerUsername String?
  owner         User?   @relation("PageOwner", fields: [ownerUsername], references: [username], onUpdate: Cascade, onDelete: SetNull)

  currentRevisionId String?   @unique @db.Uuid // current-revision pointer (ADR 0003)
  current           Revision? @relation("PageCurrent", fields: [currentRevisionId], references: [id])

  revisions Revision[] @relation("PageRevisions")

  // null = MDX page; set = entry of this form (ADR 0014). Deleting the form
  // cascades to its entries.
  formId String? @db.Uuid
  form   Form?   @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([ownerUsername])
}

// One line of the « seulement » list: a person or a group, never both — a
// CHECK in the migration holds the invariant, as it does for GroupMember.
// Cascade on both sides: the right disappears with what it names, which is
// the intended effect (ADR 0024) — where the same cascade on ownership would
// have destroyed pages.
model PageAcl {
  id String @id @default(uuid(7)) @db.Uuid

  pageId String @db.Uuid
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  kind PermKind

  username String?
  user     User?   @relation(fields: [username], references: [username], onUpdate: Cascade, onDelete: Cascade)

  groupSlug String?
  group     Group?  @relation(fields: [groupSlug], references: [slug], onUpdate: Cascade, onDelete: Cascade)

  @@unique([pageId, kind, username])
  @@unique([pageId, kind, groupSlug])
  @@index([username])
  @@index([groupSlug])
}

model Revision {
  id        String   @id @default(uuid(7)) @db.Uuid
  content   String? // full MDX snapshot, not a delta — MDX pages
  data      Json? // field-values snapshot — entries (ADR 0014)
  // Invariant (enforced by a CHECK in the migration): exactly one of
  // (content, data) is set, per the page's nature.
  // Second CHECK: `data` always carries a non-empty `title` — computed at
  // write, automatic mode included, never at read (ADR 0020).
  createdAt DateTime @default(now())

  // A live reference, not a frozen name (ADR 0024): renaming an account
  // renames its signature throughout the history. SetNull, not Cascade —
  // erasing an account must not tear pans of history out.
  authorUsername String?
  author         User?   @relation("RevisionAuthor", fields: [authorUsername], references: [username], onUpdate: Cascade, onDelete: SetNull)

  pageId String @db.Uuid
  page   Page   @relation("PageRevisions", fields: [pageId], references: [id], onDelete: Cascade)

  // History label for restores; SetNull so it never blocks a page's hard-delete cascade.
  restoredFromId String?    @db.Uuid
  restoredFrom   Revision?  @relation("RestoredFrom", fields: [restoredFromId], references: [id], onDelete: SetNull)
  restoredInto   Revision[] @relation("RestoredFrom")

  currentOf Page? @relation("PageCurrent")

  @@index([authorUsername])
}
